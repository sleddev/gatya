{
  "name": "pants",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "main": "expo-router/entry",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "start": "node scripts/dev.mjs",
    "android": "node scripts/dev.mjs --android",
    "ios": "node scripts/dev.mjs --ios",
    "web": "node scripts/dev.mjs --web",
    "content": "node scripts/build-content.mjs",
    "content:watch": "node scripts/build-content.mjs --watch",
    "build:web": "pnpm content && expo export --platform web",
    "typecheck": "pnpm content && tsc --noEmit",
    "test": "node --no-warnings --test \"src/lib/*.test.ts\"",
    "check": "pnpm typecheck && pnpm test && expo export --platform web --output-dir dist && expo export --platform android --output-dir dist-android",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "node scripts/build-content.mjs || echo \"content build failed, run pnpm content for details\""
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.27",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-router": "~57.0.25",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "fuse.js": "^7.5.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1"
  },
  "devDependencies": {
    "@mdx-js/mdx": "^3.1.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "@types/react": "~19.2.2",
    "github-slugger": "^2.0.0",
    "hast-util-to-string": "^3.0.1",
    "katex": "^0.19.0",
    "mdast-util-to-string": "^4.0.0",
    "rehype-katex": "^7.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-mdx": "^3.1.1",
    "remark-mdx-frontmatter": "^6.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "~6.0.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "packageManager": "pnpm@11.28.4"
}
